{
  "name": "morningstar-cli",
  "version": "1.5.1",
  "description": "Morningstar AI - sovereign multi-provider terminal coding agent",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "morningstar": "bin/morningstar.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run typecheck && npm test && npm run build",
    "telegram": "tsx src/index.ts telegram",
    "typecheck": "tsc --noEmit",
    "launch:ollama": "node scripts/launch-ollama.mjs",
    "hygiene": "node scripts/check-public-hygiene.mjs",
    "hygiene:worktree": "node scripts/check-public-hygiene.mjs --worktree"
  },
  "dependencies": {
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/headless": "6.0.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^14.0.6",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.2.1",
    "ora": "^8.1.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "shiki": "^1.29.2",
    "string-width": "4.2.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.28",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "main": "./dist/headless.js",
  "types": "./dist/headless.d.ts",
  "exports": {
    ".": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "scripts/launch-ollama.mjs",
    "SECURITY.md",
    "PARITY.md",
    "docs/distribution.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morningstarnasser/morningstar-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/morningstarnasser/morningstar-cli/issues"
  },
  "homepage": "https://github.com/morningstarnasser/morningstar-cli#readme"
}
